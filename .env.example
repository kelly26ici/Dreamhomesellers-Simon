# ── Database (inherited from the previous project — schema unchanged) ──────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_KEY=your-supabase-service-key

# Async Postgres pool (preferred access path for the agent's tools)
# Session pooler on port 6543 — transaction pooling is fine for our access pattern
POSTGRES_DSN=postgresql://postgres.YOUR-PROJECT:YOUR-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:6543/postgres

# ── Vector store ────────────────────────────────────────────────────────────
QDRANT_URL=https://YOUR-QDRANT-CLUSTER.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key

# ── Chat models ─────────────────────────────────────────────────────────────
# Primary: NVIDIA NIM (build.nvidia.com) — Nemotron
NVIDIA_API_KEY=your-nvidia-build-api-key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
SIMON_NEMOTRON_MODEL=nvidia/...

# Fallbacks / extras
GEMINI_API_KEY=your-google-ai-studio-key
SIMON_GEMINI_MODEL=gemini-...

GROQ_API_KEY=your-groq-key
SIMON_GROQ_MODEL=...

# Poolside (OpenAI-compatible endpoint, if available)
POOLSIDE_API_KEY=your-poolside-key
POOLSIDE_BASE_URL=https://...
SIMON_POOLSIDE_MODEL=...

# ── Web search for the agent ───────────────────────────────────────────────
TAVILY_API_KEY=your-tavily-key

# ── LangSmith tracing ───────────────────────────────────────────────────────
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-langsmith-key
LANGSMITH_PROJECT=simon
