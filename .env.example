# ── Database (inherited from the previous project — schema unchanged) ──────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_KEY=your-supabase-service-key

# Async Postgres (optional — direct DB access once the password exists)
# Session pooler = port 5432, transaction pooler = port 6543 (needs
# statement_cache_size=0 with asyncpg)
POSTGRES_DSN=postgresql://postgres.YOUR-PROJECT:YOUR-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres

# ── Vector store ────────────────────────────────────────────────────────────
QDRANT_URL=https://YOUR-QDRANT-CLUSTER.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key

# ── Embeddings (must match the 1024-dim vectors already in Qdrant) ─────────
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# ── Chat models ─────────────────────────────────────────────────────────────
# Primary: NVIDIA NIM (build.nvidia.com) — Nemotron
NVIDIA_API_KEY=your-nvidia-build-api-key
SIMON_NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Fallbacks / extras
GEMINI_API_KEY=your-google-ai-studio-key
SIMON_GEMINI_MODEL=google_genai:gemini-3.8-flash

GROQ_API_KEY=your-groq-key
SIMON_GROQ_MODEL=groq:openai/gpt-oss-120b

# Poolside (OpenAI-compatible endpoint)
POOLSIDE_API_KEY=your-poolside-key
SIMON_POOLSIDE_MODEL=openai:poolside/laguna-s-2.1

# ── Web search for the agent ───────────────────────────────────────────────
TAVILY_API_KEY=your-tavily-key

# ── LangSmith tracing ───────────────────────────────────────────────────────
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-langsmith-key
LANGSMITH_PROJECT=simon
